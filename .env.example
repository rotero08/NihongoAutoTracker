# ─── NihongoAutoTracker Development Environment ───────────────
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — your secrets stay local.

# Your NihongoTracker API key (pre-populates config in dev mode)
VITE_NT_API_KEY=

# Enable mock data injection in popup/settings (true / false)
# When "true", the popup and settings pages will be pre-populated
# with sample reading and video queue items for testing.
VITE_MOCK_DATA=true
