# ─── NihongoAutoTracker Development Environment ───────────────
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — your secrets stay local.

# The default target browser to run and build for (e.g., chrome, firefox, edge, safari)
# Overrides WXT's default browser choice when running `pnpm run dev`
WXT_BROWSER=firefox

# Your NihongoTracker API key (pre-populates config in dev mode)
VITE_NT_API_KEY=

# Enable mock data injection in popup/settings (true / false)
# When "true", the popup and settings pages will be pre-populated
# with sample reading and video queue items for testing.
VITE_MOCK_DATA=true

# ─── Firefox Add-on Store (AMO) Configuration ────────────────
# These credentials are used if you want to run builds, validation, 
# or submission commands locally from your terminal. 
# 
# To get these credentials:
# 1. Log into the Firefox Add-ons Developer Hub (https://addons.mozilla.org/developers/)
# 2. Go to "Tools" -> "API Keys" or visit: https://addons.mozilla.org/developers/addon/api/key/
# 3. Generate your credentials.

# Your JWT Issuer key from the Firefox Developer Hub
WXT_FIREFOX_API_KEY=

# Your JWT Secret key from the Firefox Developer Hub
WXT_FIREFOX_API_SECRET=

# The unique ID of your extension (found on your AMO dashboard after submission).
# This must match the 'gecko.id' value defined in your wxt.config.ts file.
WXT_FIREFOX_ADDON_ID=